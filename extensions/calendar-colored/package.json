{
	"name": "calendar-colored",
	"description": "Colored calendar layout for Directus with task contrast styling",
	"icon": "extension",
	"version": "1.0.0",
	"keywords": [
		"directus",
		"directus-extension",
		"directus-extension-layout"
	],
	"type": "module",
	"files": [
		"dist"
	],
	"directus:extension": {
		"type": "layout",
		"path": "dist/index.js",
		"source": "src/index.ts",
		"host": "^10.10.0"
	},
	"scripts": {
		"build": "directus-extension build",
		"dev": "directus-extension build -w --no-minify",
		"link": "directus-extension link",
		"validate": "directus-extension validate"
	},
	"devDependencies": {
		"@directus/extensions-sdk": "18.0.6",
		"typescript": "^5.4.5",
		"vue": "^3.5.43",
		"vue-router": "^4.6.3"
	}
}
